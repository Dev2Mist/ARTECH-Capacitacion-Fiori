{
  "_version": "1.76.0",
  "sap.app": {
    "id": "artech.capacitacion.fiori",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.6",
      "toolsId": "2a9dee43-7a6e-458c-93f2-d14d8e1acd3d"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.143.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "artech.capacitacion.fiori.i18n.i18n"
        }
      },
      "profile": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/data.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "artech.capacitacion.fiori.view",
        "async": true,
        "viewPath": "artech.capacitacion.fiori.view"
      },
      "routes": [
        {
          "name": "RouteApp",
          "pattern": ":?query:",
          "target": ["TargetApp"]
        },
        {
          "name": "RouteHobbies",
          "pattern": "hobbies",
          "target": ["TargetHobbies"]
        },
        {
          "name": "RouteJob",
          "pattern": "Job/{company}",
          "target": ["TargetJob"]
        }
      ],
      "targets": {
        "TargetApp": {
          "id": "App",
          "name": "App"
        },
        "TargetHobbies": {
          "id": "Hobbies",
          "name": "Hobbies"
        },
        "TargetJob": {
          "id": "Job",
          "name": "Job"
        }
      }
    },
    "rootView": {
      "viewName": "artech.capacitacion.fiori.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
