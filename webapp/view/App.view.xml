<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="artech.capacitacion.fiori.controller.App"
    displayBlock="true">

    <App>

        <Page title="Inicio">

            <content>
                
                <VBox 
                    class="sapUiSmallMargin"
                    alignItems="Center"
                    justifyContent="Center"
                    height="100%">

                <Title text="¡Bienvenido a mi App!"
                        titleStyle="H2"
                        class="sapUiMediumMarginBottom" />
                
                    <Label text="Ingresa tu nombre: " />

                    <Input id="inputUsuario" placeholder="Escribí acá..." width="300px" />

                    <Button text="Saludar" press=".onMostrarSaludo" type="Emphasized" />

                </VBox>
            </content>

        </Page>
    </App>

</mvc:View>